# ============ VARIABLES DU SITE (Vercel ou .env.local) ============

# Discord OAuth — créer une app sur https://discord.com/developers/applications
# Redirection : https://TON_DOMAINE/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Bot API — URL publique du bot (Railway) + même clé que le bot
BOT_API_URL=http://localhost:3001
API_KEY=

# Optionnel — en prod sur Vercel, mettre l’URL du site (ex. https://sayuri-games.vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
